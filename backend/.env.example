# ============================================================
# SmartHR Backend Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Database (Neon DB connection string)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://smarthr_user:YOUR_PASSWORD@ep-xxx.us-east-1.aws.neon.tech/smarthr?sslmode=require

# JWT Configuration
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_for_security
JWT_EXPIRY=8h

# Client URL (React frontend for CORS)
CLIENT_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Office Geo-fence (for Attendance tracking)
# Set to 0,0 to disable geo-fencing
OFFICE_LAT=37.7749
OFFICE_LNG=-122.4194
OFFICE_RADIUS_KM=0.5

# Logging
LOG_LEVEL=info